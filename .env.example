# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# PostgreSQL connection (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/the_society

# Comma-separated Telegram user IDs that become super_admin automatically
SUPER_ADMIN_IDS=123456789,987654321

# If true, events created by moderators need super_admin approval before going live
REQUIRE_EVENT_APPROVAL=true
